{
  "name": "react-api-state",
  "version": "0.1.5",
  "description": "React API state management with offline-first persistence, synchronization, caching, and optimistic updates.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck && npm run test"
  },
  "keywords": [
    "react",
    "reactjs",
    "react-hooks",
    "react-state",
    "state-management",
    "api",
    "api-state",
    "data-fetching",
    "server-state",
    "async-state",
    "offline-first",
    "local-first",
    "offline",
    "persistence",
    "synchronization",
    "sync",
    "optimistic-updates",
    "caching",
    "typescript"
  ],
  "author": "Om Prakash Tiwari <optiwari.india@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/optiwariindia/react-api-state.git"
  },
  "bugs": {
    "url": "https://github.com/optiwariindia/react-api-state/issues"
  },
  "homepage": "https://github.com/optiwariindia/react-api-state#readme",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
